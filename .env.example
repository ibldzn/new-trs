APP_NAME="THOR Rate Sync"
APP_ENV=development
APP_URL=http://localhost:8080
# Empty listens on every interface; set 127.0.0.1 behind a local reverse proxy.
APP_BIND_HOST=
APP_PORT=8080
APP_SHUTDOWN_TIMEOUT=45s
APP_TIMEZONE=Asia/Jakarta

# Optional branding images (svg, png, jpg, webp, gif, ico; max 2 MiB). Any
# size works: logos are scaled to fit the sidebar. Empty uses a letter badge
# from APP_NAME. Files are read at startup; restart after replacing them.
# APP_LOGO_FILE is square (collapsed sidebar). APP_LOGO_WIDE_FILE, if set,
# replaces the badge and app name in the expanded sidebar.
APP_LOGO_FILE=
APP_LOGO_WIDE_FILE=
APP_FAVICON_FILE=
THOR_API_KEY=

# TCP (default when DB_NETWORK is omitted)
DB_NETWORK=tcp
DB_HOST=127.0.0.1
DB_PORT=3306
# Unix socket: replace the TCP block above with these values.
# DB_NETWORK=unix
# DB_SOCKET=/var/run/mysqld/mysqld.sock
DB_NAME=trs
DB_USER=root
DB_PASSWORD=

THOR_BOOTSTRAP_ACCESS_MANAGERS=

SESSION_COOKIE_NAME=trs_session
SESSION_LIFETIME=24h
SESSION_REMEMBER_LIFETIME=720h
SESSION_SECURE=false

# Failed Fincloud logins per username before further attempts are refused
# without contacting Fincloud.
AUTH_LOGIN_FAILURE_WINDOW=15m
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_LOCKOUT=15m

DWH_DBSTRING=
MSO_DBSTRING=

FINCLOUD_BASE_URL=
FINCLOUD_SYSTEM_USERNAME=
FINCLOUD_SYSTEM_PASSWORD=
FINCLOUD_SYSTEM_LOCATION_ID=000
FINCLOUD_SYSTEM_ROLE_ID=R-0041
FINCLOUD_CA_FILE=
FINCLOUD_INSECURE_TLS=false
FINCLOUD_HTTP_TIMEOUT=30s
FINCLOUD_MAX_REPORT_BYTES=104857600

TODAY_SNAPSHOT_REFRESH_INTERVAL=3h
TODAY_SNAPSHOT_REFRESH_ON_START=true

SLIK_CONCURRENCY=16
SLIK_MAX_UPLOAD_BYTES=67108864
SLIK_STORAGE_DIR=./data/slik
LPS_DEFAULT_KODE_KEPESERTAAN=31300082
