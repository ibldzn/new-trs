DB_PASSWORD=

ALLOW_REGISTRATION=false

SESSION_COOKIE_NAME=trs_session
SESSION_LIFETIME=24h
SESSION_REMEMBER_LIFETIME=720h
SESSION_SECURE=false

DWH_DBSTRING=
MSO_DBSTRING=
MSO_DEBTOR_TYPE_QUERY=
MSO_INTEREST_TYPE_QUERY=

FINCLOUD_BASE_URL=
FINCLOUD_SYSTEM_USERNAME=
FINCLOUD_SYSTEM_PASSWORD=
